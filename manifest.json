{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.dbx.kubernetes",
  "name": "Kubernetes Manager",
  "version": "0.1.1",
  "publisher": "eryajf",
  "description": "Manage Kubernetes clusters, workloads and resources from DBX.",
  "icon": "assets/plugin.png",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "permissions": [
    "host.events"
  ],
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-kubernetes"
    },
    "ui": {
      "root": "ui/dist",
      "entry": "ui/dist/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.dbx.kubernetes.connection",
      "label": "Kubernetes cluster",
      "icon": "assets/plugin.png",
      "database_type": "kubernetes",
      "description": "Connect to a Kubernetes cluster using kubeconfig.",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "default": "Kubernetes cluster",
          "binding": "name",
          "required": true
        },
        {
          "key": "kubeconfig",
          "label": "Kubeconfig",
          "type": "textarea",
          "binding": "secret",
          "required": true,
          "description": "Kubeconfig YAML stored in DBX secret store."
        },
        {
          "key": "server",
          "label": "API Server (optional)",
          "type": "text",
          "binding": "config",
          "description": "Use with token or client certificate when kubeconfig is not provided."
        },
        {
          "key": "token",
          "label": "Bearer token",
          "type": "password",
          "binding": "secret"
        },
        {
          "key": "ca_cert",
          "label": "CA certificate (PEM)",
          "type": "textarea",
          "binding": "secret"
        },
        {
          "key": "client_cert",
          "label": "Client certificate (PEM)",
          "type": "textarea",
          "binding": "secret"
        },
        {
          "key": "client_key",
          "label": "Client key (PEM)",
          "type": "textarea",
          "binding": "secret"
        },
        {
          "key": "context",
          "label": "Kubeconfig context",
          "type": "text",
          "binding": "config"
        },
        {
          "key": "timeout_s",
          "label": "Timeout (seconds)",
          "type": "number",
          "default": 30,
          "binding": "config"
        },
        {
          "key": "insecure_skip_tls_verify",
          "label": "Skip TLS verification",
          "type": "boolean",
          "default": false,
          "binding": "config"
        },
        {
          "key": "allow_exec",
          "label": "Allow kubeconfig exec credentials",
          "type": "boolean",
          "default": false,
          "binding": "config",
          "description": "Only enable for trusted kubeconfig files."
        },
        {
          "key": "namespace",
          "label": "Default namespace",
          "type": "text",
          "default": "default",
          "binding": "config"
        }
      ],
      "workbench": "io.dbx.kubernetes.workbench",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.dbx.kubernetes.workbench",
      "label": "Kubernetes Workbench",
      "description": "Browse and operate Kubernetes resources."
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "Kubernetes 管理",
      "description": "在 DBX 中管理 Kubernetes 集群、工作负载和资源。",
      "contributions": {
        "io.dbx.kubernetes.connection": {
          "label": "Kubernetes 集群",
          "fields": {
            "display_name": {
              "label": "连接名称"
            },
            "kubeconfig": {
              "label": "Kubeconfig"
            },
            "server": {"label": "API Server（可选）"},
            "token": {"label": "Bearer Token"},
            "ca_cert": {"label": "CA 证书（PEM）"},
            "client_cert": {"label": "客户端证书（PEM）"},
            "client_key": {"label": "客户端私钥（PEM）"},
            "context": {"label": "Kubeconfig Context"},
            "timeout_s": {"label": "超时时间（秒）"},
            "insecure_skip_tls_verify": {"label": "跳过 TLS 校验"},
            "allow_exec": {"label": "允许执行 Kubeconfig 凭据插件"},
            "namespace": {
              "label": "默认命名空间"
            }
          }
        },
        "io.dbx.kubernetes.workbench": {
          "label": "Kubernetes 工作台"
        }
      }
    }
  }
}
